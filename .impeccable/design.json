  "narrative": {
    "northStar": "The Catalog Wall",
    "overview": "Armarium is a dark wall of real covers: a cool near-black ground, two lifted grey-blue surfaces and hairline rules, with covers supplying every colour. A hovered or focused cover widens in place into a card that says what it is. Headings are Bebas Neue capitals; data is system UI with tabular figures. One amber marks where you are and what reads; everything else is a neutral outline. The same ground carries into the reader and viewer.",
    "keyCharacteristics": [
      "Covers are the only colour",
      "Amber reserved for focus, current nav, progress and reading actions",
      "Condensed caps for headings, system UI for data",
      "Flat tonal chrome; soft shadows only on lifted covers",
      "Gradients only as scrims over cover imagery"
    ],
    "rules": [
      {
        "name": "The Covers-Are-The-Colour Rule",
        "body": "No hue enters the chrome; colour comes from cover images.",
        "section": "colors"
      },
      {
        "name": "The Amber Reservation Rule",
        "body": "Amber at rest means current location, progress or a reading action; every other button is a neutral outline. A second amber button on one screen is a bug.",
        "section": "colors"
      },
      {
        "name": "The Caps-Name, System-Count Rule",
        "body": "Every heading is Bebas Neue caps; no data in Bebas, no heading in the system face.",
        "section": "typography"
      },
      {
        "name": "The Caption-Follows Rule",
        "body": "Caption caps follow or sit beside what they describe; never above a heading as its label.",
        "section": "typography"
      },
      {
        "name": "The Scrim-Only Gradient Rule",
        "body": "Gradients only lay the ground over cover imagery.",
        "section": "elevation"
      },
      {
        "name": "The Known Limit",
        "body": "The blurred own-cover hero backdrop reads as a dim streak on mostly-black covers; accepted, not to be compensated with tint or opacity.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let covers carry all colour",
      "Do mark focus with a 1px amber outline at 2px offset",
      "Do give coverless items a title plate",
      "Do keep reading actions amber and everything else neutral outline",
      "Do style via classes and Svelte style: directives; the CSP forbids inline style attributes",
      "Do self-host fonts",
      "Do honour prefers-reduced-motion"
    ],
    "donts": [
      "Don't use a second amber button on a screen",
      "Don't put gradients on chrome",
      "Don't set headings in the system face or data in Bebas Neue",
      "Don't set a caps caption above a heading as its label",
      "Don't shadow flat chrome",
      "Don't use hard offset or tinted shadows",
      "Don't let a book's stylesheet win on measure, margins or body size"
    ]
  }
}